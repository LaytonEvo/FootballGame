{
  "version": "0.3",
  "season": "2026-27-test",
  "status": "v0.2 points table plus the substitute fallbacks: cameo sub and captaincy passing to the sub",
  "rules": {
    "actions_per_starter": {
      "min": 1,
      "max": 2
    },
    "no_two_actions_from_same_overlap_group": true,
    "captain_multiplier": 2,
    "bold_action": {
      "per_gameweek": 1,
      "multiplier_if_landed": 2,
      "penalty_if_missed": "-50% of base points, rounded up"
    },
    "max_chaos_actions_per_squad": 1,
    "rarity_multiplier": {
      "bronze": 1.2,
      "silver": 1.1,
      "gold": 1.0,
      "elite": 0.9
    },
    "order_of_operations": "base points x rarity multiplier x bold (if landed) x captain; round to nearest integer at the end",
    "points_fixed_for_season": true,
    "deadline": "90 minutes before first kick-off of the gameweek; server-enforced",
    "finalisation": "09:00 Europe/London the morning after the last match of the gameweek; no changes after",
    "clean_sheet_min_minutes": 60,
    "double_gameweek": "resolve on combined stats across both matches",
    "zero_minutes": "substitute comes in with their own pre-set actions",
    "sub_cameo_minutes": 30,
    "captain_passes_to_sub": true
  },
  "tiers": {
    "likely": "hit rate >= 40%",
    "possible": "20-40%",
    "bold": "8-20%",
    "long_shot": "< 8%",
    "chaos": "discipline actions, max one per squad"
  },
  "removed": ["red_card", "own_goal", "penalty_missed (under 1% of matches; main spot-fixing markets)"],
  "parked": [
    "off_bench_and_scores (sub slot only; reprice later)",
    "shots_on_target, chances_created, dribbles, interceptions, penalties scored/won/conceded, headed and outside-box goals (advanced feed; untested)"
