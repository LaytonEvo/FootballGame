{
  "name": "Clean Fantasy",
  "theme": "light",
  "color": {
    "background": "#F4F6FA",
    "surface": "#FFFFFF",
    "border": "#E3E7EF",
    "divider": "#EEF1F6",
    "track": "#E6EAF2",
    "ink": "#10153A",
    "muted": "#5A6178",
