  "spacing_px": [4, 8, 12, 16, 20, 24, 32],
  "icons": {
    "style": "Gradient tile",
    "active": "white 2px stroke icon on a 40x32 gradient tile, radius 10, shadow 0 3px 8px rgba(61,90,254,0.30); label in active colour",
    "inactive": "1.8px muted outline, no tile",
    "set": ["home", "squad (shirt)", "collection (cards)", "leagues (trophy)", "profile"]
  },
  "touch_target_min_px": 44,
  "motion": {
    "pack_open": "0.6s shake, 0.4s tear + rarity glow, 0.6s card flip, 0.3s fade-in of name and buttons; Skip always visible; Reduce Motion = fade only; no near-miss effects"
  }
