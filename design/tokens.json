    },
    "namePlate": {
      "top": "#FFFFFF",
      "bottom": "#EEF1F6",
      "text": "#10153A"
    },
    "rarity": {
      "bronze": "#A9683A",
      "silver": "#7C8796",
      "gold": "#B8860B",
      "elite": "#6A55E0"
    }
  },
  "font": {
    "heading": {
      "family": "Sora",
      "weights": [600, 700]
    },
    "body": {
      "family": "DM Sans",
      "weights": [400, 500, 600, 700]
    },
    "source": "Google Fonts"
  },
  "type_scale_px": {
    "hero": 46,
    "h1": 24,
    "h2": 22,
    "h3": 17,
    "body": 15,
    "small": 13,
