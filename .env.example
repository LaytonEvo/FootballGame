# API / worker
# DATABASE_URL=postgres://user:pass@host:5432/fantasyfive   # omit for embedded PGlite in apps/api/.data
# REDIS_URL=redis://localhost:6379                           # omit to run the worker's in-process loop
PORT=3000
SEASON=2026-27-test
DATA_PROVIDER=fpl-dataset            # or "commercial" once the contract is signed
PHONE_HASH_SECRET=change-me          # HMAC key for phone numbers (never store raw numbers)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_VERIFY_SERVICE_SID=         # set all three to send real SMS codes; otherwise codes are logged (dev only)
# OTP_BYPASS_CODE=000000           # TESTING ONLY: no SMS, the app signs any number in with this code
# EXPO_ACCESS_TOKEN=                 # optional, for Expo push
PUSH_PROVIDER=expo                   # "none" to disable push delivery
STAFF_TOKENS=alice:replace-with-a-long-random-token
PUBLIC_WEB_URL=https://fantasyfive.test
GAME_NAME=Fantasy Five

# Admin console
VITE_API_URL=http://localhost:3000
